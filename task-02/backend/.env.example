# Server Port (Render automatically sets PORT in production)
PORT=5000

# Option 1: Supabase Connection String (Recommended for Cloud / Render)
# In Supabase: Project Settings -> Database -> Connection string (URI) -> Mode: Session or Transaction
# Example:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Option 2: Local PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=serendib_store
