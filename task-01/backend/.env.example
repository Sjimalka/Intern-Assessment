# Server Port
PORT=5000

# PostgreSQL Connection Configuration
# You can use a full connection URL (e.g. from Neon, Supabase, Render, or local):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db

# Or configure individual connection parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pos_db
PGSSL=false
